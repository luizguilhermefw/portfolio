generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Admin {
  id           String         @id @default(uuid()) @db.Char(36)
  legacyId     Int?           @unique
  username     String         @unique
  passwordHash String @db.LongText
  createdAt    DateTime       @default(now()) @db.DateTime(3)
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(uuid()) @db.Char(36)
  tokenHash String   @unique @db.Char(64)
  adminId   String   @db.Char(36)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Category {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String @db.LongText
  slug      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  posts     Post[]
}

model Post {
  id              String     @id @default(uuid()) @db.Char(36)
  legacyId        Int?       @unique
  title           String @db.LongText
  slug            String     @unique @db.VarChar(200)
  contentHtml     String     @db.LongText
  excerpt         String? @db.LongText
  legacyCategory  String? @db.LongText
  categoryId      String?    @db.Char(36)
  imageUrl        String? @db.LongText
  createdAt       DateTime   @default(now()) @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @db.DateTime(3)
  publishedAt     DateTime?  @db.DateTime(3)
  status          PostStatus @default(DRAFT)
  metaDescription String? @db.LongText
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt, createdAt, id])
}
